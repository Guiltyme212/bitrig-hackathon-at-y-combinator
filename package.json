{
  "name": "kokoro-duo",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.128.0",
    "@expo/metro-runtime": "~57.0.16",
    "@expo/ui": "~57.0.20",
    "@react-native-masked-view/masked-view": "0.3.2",
    "@shopify/react-native-skia": "2.6.2",
    "expo": "~57.0.24",
    "expo-audio": "~57.0.5",
    "expo-blur": "~57.0.3",
    "expo-constants": "~57.0.19",
    "expo-glass-effect": "~57.0.4",
    "expo-haptics": "~57.0.3",
    "expo-image": "~57.0.5",
    "expo-linear-gradient": "~57.0.2",
    "expo-linking": "~57.0.11",
    "expo-router": "~57.0.23",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.3",
    "expo-video": "~57.0.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-purchases": "^10.10.2",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "^0.21.2",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@expo/ngrok": "^4.1.3",
    "@higgsfield/client": "^0.2.6",
    "@types/node": "^26.6.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "~19.2.2",
    "dotenv": "^18.0.0",
    "qrcode": "^1.5.4",
    "tsx": "^4.23.13",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "npm run preview",
    "android": "EXPO_NO_DOTENV=1 expo start --android --port 8081",
    "ios": "EXPO_NO_DOTENV=1 expo start --ios --port 8081",
    "web": "npm run preview",
    "typecheck": "tsc --noEmit",
    "export:web": "EXPO_NO_DOTENV=1 expo export --platform web --output-dir dist/web",
    "export:ios": "EXPO_NO_DOTENV=1 expo export --platform ios --output-dir dist/ios",
    "generate:example": "tsx server/higgsfield/index.ts",
    "generate:orb": "tsx server/higgsfield/index.ts --orb",
    "key:higgsfield": "tsx server/higgsfield/set-key.ts",
    "generate:music": "tsx server/music.ts",
    "test": "node --import tsx --test tests/*.test.ts",
    "phone:qr": "tsx server/phone-preview.ts",
    "orb:poster": "tsx scripts/ember-poster.ts",
    "make:meditation": "tsx server/meditation/cli.ts",
    "qa:8086": "EXPO_NO_DOTENV=1 expo start --go --lan --port 8086",
    "tunnel:8087": "EXPO_NO_DOTENV=1 expo start --go --tunnel --port 8087",
    "brain:setup": "tsx server/brain/setup.ts",
    "brain:try": "tsx server/brain/try.ts",
    "preview": "EXPO_NO_DOTENV=1 KOKORO_DUO=1 KOKORO_DUO_PORT=8090 expo start --localhost --port 8090",
    "check": "npm run typecheck && npm test"
  },
  "private": true
}
